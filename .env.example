# Copy to .env and adjust. .env is git-ignored.

# Database (used by compose.yaml; choose any long random password)
POSTGRES_PASSWORD=change-me

# Ollama. Empty URL = Ollama on this computer (http://host.docker.internal:11434 from the api container,
# http://localhost:11434 for the command line). Set it to use Ollama on another computer, e.g. http://192.168.1.50:11434
# (a bare host like 192.168.1.50 works too: http:// and port 11434 are added)
OLLAMA_BASE_URL=
OLLAMA_MODEL=gemma4:e4b
# Seconds to wait for the model; on a Raspberry Pi use about 600
OLLAMA_TIMEOUT=120

# Sessions: days until a login expires (renewed while in use); COOKIE_SECURE=true once HTTPS exists
SESSION_DAYS=90
COOKIE_SECURE=false

# Background generation of daily readings
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15
GENERATION_START=00:05
# Also prepare tomorrow and the day after (the app's day switch); 0 = only today
GENERATE_DAYS_AHEAD=2

# Web: port on the home network (behind a reverse proxy on the same machine: 127.0.0.1:8094), and the source code URL shown in the app (AGPL; point it to your fork if you change the code)
WEB_PORT=80
SOURCE_URL=https://github.com/mediaworkbench/astrocat

# Self-registration in the app: people need this invite code to create an account.
# Leave empty to turn registration off (accounts then only via `astrocat create-user`).
REGISTRATION_CODE=
